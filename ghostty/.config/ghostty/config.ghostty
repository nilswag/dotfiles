
# set initial window size
window-width = 120
window-height = 50

# set font
font-family = "GoMono Nerd Font"
# font-family = "CodeNewRoman Nerd Font"

# turn off annoying confirmation popups
confirm-close-surface = false
clipboard-paste-protection = false

# workaround for clear not working in ssh sessions
command = TERM=xterm-256color /usr/bin/zsh
